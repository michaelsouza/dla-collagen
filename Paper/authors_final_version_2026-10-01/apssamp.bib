@article{Godano1993,
	abstract = {We analyse a seismic catalogue of South California to
               investigate the possibility of earthquake prediction using the
               hypothesis that the seismic events are self-organized critical
               phenomena. The relation found previously is valid only in a mean
               field approximation, but cannot be used for earthquake
               prediction because the time clustering of seismic events makes
               the definition of a standard deviation of waiting times of
               earthquakes impossible.},
	author = {Godano, C and Alonzo, M L and Caruso, V},
	journal = {Phys. Earth Planet. Inter.},
	language = {english},
	month = nov,
	number = {3-4},
	pages = {117--123},
	publisher = {Elsevier BV},
	title = {Self-organized criticality and earthquake predictability},
