@article{Meibom1996,
	abstract = {Inspired by the discovery of Oddershede et al. [Phys. Rev. Lett.
               71, 3107 (1993)] concerning the dimensionality dependence of
               mass distributions after shock fragmentation, we have performed
               further experiments using thick plates of dry clay. We observe
               mass distributions with composite power laws, i.e., different
               exponents for fragments larger and smaller than the plate
               thickness. This implies that the dominant exponent for any given
               fragment mass corresponds to the dimensionality of the original
               object on the length scale of the fragment considered. We study
               two profoundly different models, both of which agree
               qualitatively with the observed features. Thus the measured mass
               distribution tells little about the mechanisms of the
               fragmentation process.},
	author = {Meibom, A and Balslev, I, I},
	copyright = {http://link.aps.org/licenses/aps-default-license},
	journal = {Phys. Rev. Lett.},
	language = {en},
	month = apr,
	number = 14,
	pages = {2492--2494},
	publisher = {American Physical Society (APS)},
	title = {Composite power laws in shock fragmentation},
	volume = 76,
	year = 1996}

@article{Diehl2000,
	abstract = {We investigate the explosive fragmentation process in two
               dimensions using molecular-dynamics simulations. We show that
               the mass distribution of fragments follows a power law, with a
               scaling exponent that is strongly dependent on the macroscopic
               characteristics of the system prior to the explosion process. In
               particular, for thermalized initial configurations at low
               temperatures, we observe that the exponent is close to -1. We
               suggest that this result can be interpreted in terms of a
               multiplicative fracture process.},
	author = {Diehl, A and Carmona, H A and Araripe, L E and Andrade, Jr, J S and Farias, G A},
	copyright = {http://link.aps.org/licenses/aps-default-license},
	journal = {Phys. Rev. E Stat. Phys. Plasmas Fluids Relat. Interdiscip. Topics},
	language = {en},
	month = oct,
	number = {4 Pt A},
	pages = {4742--4746},
	publisher = {American Physical Society (APS)},
	title = {Scaling behavior in explosive fragmentation},
	volume = 62,
	year = 2000}

@article{Diehl2002,
	abstract = {Following the suggestion in the Comment on our previous work by
               {\AA}str{\"o}m, Linna, and Timonen [Phys. Rev. E 65, 048101
               (2002)], we performed extensive molecular-dynamics simulations
               to confirm that our numerical results for the mass distribution
               of fragments after the ``explosion'' of thermalized samples are
               consistent with the scaling form
               $n(m)\ensuremath\{\sim\}\{m\}^\{\ensuremath\{-\}(\ensuremath\{\alpha\}+1)\}\{f(m/M\}_\{0\}),$
               where $\{f(m/M\}_\{0\})$ is a cutoff function, $\{M\}_\{0\}$ is
               a cutoff parameter, and the exponent $\ensuremath\{\alpha\}$ is
               close to zero.},
	author = {Diehl, A and Andrade, J S and Farias, G A},
	copyright = {http://link.aps.org/licenses/aps-default-license},
	journal = {Phys. Rev. E Stat. Phys. Plasmas Fluids Relat. Interdiscip. Topics},
	month = apr,
	number = 4,
	publisher = {American Physical Society (APS)},
	title = {Reply to ``Comment on `Scaling behavior in explosive fragmentation' ''},
	volume = 65,
	year = 2002}

@article{Araujo2003,
	abstract = {We study the statistics of the backbone cluster between two
               sites separated by distance r in two-dimensional percolation
               networks subjected to spatial long-range correlations. We find
               that the distribution of backbone mass follows the scaling
               ansatz, P(M(B)) approximately M(-(alpha+1))(B)f(M(B)/M(0)),
               where f(x)=(alpha+etax(eta))exp(-x(eta)) is a cutoff function
               and M0 and eta are cutoff parameters. Our results from extensive
               computational simulations indicate that this scaling form is
               applicable to both correlated and uncorrelated cases. We show
               that the exponent alpha can be directly related to the fractal
               dimension of the backbone d(B), and should therefore depend on
               the imposed degree of long-range correlations.},
	author = {Ara{\'u}jo, A D and Moreira, A A and Costa Filho, R N and Andrade, Jr, J S},
	copyright = {http://link.aps.org/licenses/aps-default-license},
	journal = {Phys. Rev. E Stat. Nonlin. Soft Matter Phys.},
	language = {en},
	month = feb,
	number = {2 Pt 2},
	pages = {027102},
	publisher = {American Physical Society (APS)},
	title = {Statistics of the critical percolation backbone with spatial long-range correlations},
	volume = 67,
	year = 2003}
