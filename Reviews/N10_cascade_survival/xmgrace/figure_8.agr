@g1 on
@g1 hidden false
@g1 type XY
@g1 stacked false
@g1 bar hgap 0.000000
@g1 fixedpoint off
@g1 fixedpoint type 0
@g1 fixedpoint xy 0.000000, 0.000000
@g1 fixedpoint format general general
@g1 fixedpoint prec 6, 6
@with g1
@    world 0.9, 2e-07, 400, 1.6
@    stack world 0, 0, 0, 0
@    znorm 1
@    view 1.400000, 0.300000, 2.180000, 0.860000
