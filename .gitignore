# Dados brutos: só o zip das fibrilas publicadas é versionado (adicionado com -f).
Data_fibrils
*.zip

# Python
__pycache__/
*.py[cod]
.venv/

# LaTeX: temporários, e os PDFs de Paper/, que saem do .tex
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.glg
*.glo
*.gls
*.idx
*.ilg
*.ind
*.ist
*.log
*.out
*.synctex.gz
*Notes.bib
Paper/*.pdf
Carta_Resposta/Response_to_Referees.pdf

# Pacotes locais de transferência para o cluster
cluster_bundle*/
cluster_bundle*.tar.gz

# Saídas do Quarto: reconstruíveis com `quarto render`, e o HTML embute recursos
# (1,4 MB) que mudam a cada renderização. O .qmd é a fonte.
Reviews/.quarto/
Reviews/Respostas_ER12738.html
Reviews/Respostas_ER12738.pdf

# Memória automática do Claude: fica visível no projeto, mas não versionada.
# É local à máquina por desenho, o Claude a reescreve sozinho (conflitaria entre
# sessões paralelas), e o caminho absoluto em settings.local.json não vale no cluster.
.claude/memory/
.claude/settings.local.json

# Artefato do WSL ao baixar arquivos pelo Windows: guarda a URL de origem,
# que pode conter token de sessão (o do Daniels1945 carrega um casa_token do JSTOR).
*:Zone.Identifier
